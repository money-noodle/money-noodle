{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "max",
  "modelThinkingLevels": {
    "openai-codex/gpt-6-astra": "max",
    "pi-claude-code-provider/opus": "max"
  },
  "packages": [
    "npm:pi-subagents@0.66.0",
    "npm:pi-claude-code-provider@0.2.0",
    {
      "source": "npm:pi-model-fallback@0.3.7",
      "extensions": []
    }
  ],
  "subagents": {
    "projectRootResolution": "git-root",
    "agentOverrides": {
      "scout": {
        "model": "pi-claude-code-provider/opus",
        "fallbackModels": ["openai-codex/gpt-5.6-luna"],
        "thinking": "low",
        "defaultContext": "fresh"
      },
      "worker": {
        "model": "pi-claude-code-provider/opus",
        "fallbackModels": ["openai-codex/gpt-6-astra"],
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "delegate": {
        "model": "pi-claude-code-provider/opus",
        "fallbackModels": ["openai-codex/gpt-6-astra"],
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "researcher": {
        "model": "pi-claude-code-provider/opus",
        "fallbackModels": ["openai-codex/gpt-6-astra"],
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "model": "pi-claude-code-provider/opus",
        "fallbackModels": ["openai-codex/gpt-6-astra"],
        "thinking": "high",
        "defaultContext": "fresh"
      },
      "oracle": {
        "model": "pi-claude-code-provider/opus",
        "fallbackModels": ["openai-codex/gpt-6-astra"],
        "thinking": "max",
        "defaultContext": "fresh"
      }
    }
  }
}
