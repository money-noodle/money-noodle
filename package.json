    "verify:forecast-storage": "jiti scripts/verify-forecast-storage.ts",
    "fund:long-shot": "JITI_ALIAS=\"{\\\"server-only\\\":\\\"$PWD/lib/server-only-stub.ts\\\"}\" jiti scripts/fund-long-shot.ts",
    "archive:local": "jiti scripts/archive-local-data.ts",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "analyze:edge-gates": "node --max-old-space-size=6144 scripts/analyze-edge-gates.mjs",
    "analyze:execution-value": "node --max-old-space-size=6144 scripts/analyze-execution-value.mjs",
    "analyze:trading-clock": "node --max-old-space-size=6144 scripts/analyze-trading-clock.mjs",
    "analyze:exit-alternatives": "node --max-old-space-size=6144 scripts/analyze-exit-alternatives.mjs",
    "analyze:exit-counterfactuals": "node scripts/analyze-exit-counterfactuals.mjs",
    "analyze:loss-decomposition": "node --max-old-space-size=6144 scripts/analyze-loss-decomposition.mjs",
    "analyze:take-the-ask": "node --max-old-space-size=6144 scripts/analyze-take-the-ask.mjs",
    "analyze:entry-realization": "node --max-old-space-size=6144 scripts/analyze-entry-realization.mjs",
    "analyze:missed-entries": "node --max-old-space-size=8192 --expose-gc scripts/analyze-missed-entries.mjs",
    "backfill:maker-posts": "JITI_ALIAS=\"{\\\"server-only\\\":\\\"$PWD/lib/server-only-stub.ts\\\"}\" jiti scripts/backfill-maker-post-observations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@polymarket/clob-client": "^5.8.1",
    "@radix-ui/react-dialog": "latest",
