# Copy only the sections you use to .env.local. Blank optional credentials are not required.

# --- Runtime ---
# Local persistent worker; Vercel and MONEY_NOODLE_STATELESS=true disable all collection and writes.
MONEY_NOODLE_BACKGROUND_INGESTION=true
MONEY_NOODLE_BASE_URL=http://localhost:3000
MONEY_NOODLE_STATELESS=false

# --- Hosted paper projection ---
# The local worker writes only when sync=true. Hosted/Vercel needs only a SELECT-only database URL.
MONEY_NOODLE_DATABASE_URL=
MONEY_NOODLE_POSTGRES_PAPER_SYNC=false

# --- Dashboard authentication ---
AUTH_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes

# --- Paper and percentage sizing ---
MONEY_NOODLE_MAX_PURCHASE_PERCENT=10
MONEY_NOODLE_MAX_PAPER_STAKE_CENTS=200

# --- Optional research providers ---
# Uncomment only providers you use. Model variables are optional; code defaults are shown.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# --- Optional Polymarket account view ---
# Public wallet alone enables read-only positions. Private/CLOB credentials are optional and do not grant
# live execution capability in the provider registry.
# POLYMARKET_WALLET_ADDRESS=
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_FUNDER_ADDRESS=
# POLYMARKET_SIGNATURE_TYPE=0
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYGON_RPC_URL=

# --- Kalshi signed account connector ---
KALSHI_API_KEY_ID=
# Prefer an absolute path outside the repository and chmod 600 the PEM.
KALSHI_PRIVATE_KEY_PATH=
# Inline KALSHI_PRIVATE_KEY is supported only for secret-manager injection.
# Demo: https://demo-api.kalshi.co/trade-api/v2
# Production: https://api.elections.kalshi.com/trade-api/v2
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# --- Funded execution authority and hard ceilings ---
# Live remains impossible unless the environment flag, typed operator control, reconciliation, risk gates,
# provider capability, and kill switch all permit it.
MONEY_NOODLE_ENABLE_LIVE=false
MONEY_NOODLE_KILL_SWITCH=false
MONEY_NOODLE_MAX_LIVE_STAKE_CENTS=25
MONEY_NOODLE_MAX_LIVE_ORDERS_PER_HOUR=4
# Maximum logical attempts. Under adaptive mode, attempt 2 is the sequence-local taker fallback after one
# authoritative maker miss; it is never another maker chase and there is no third attempt.
MONEY_NOODLE_MAX_LIVE_MAKER_ATTEMPTS=1
MONEY_NOODLE_MAX_PAPER_MAKER_ATTEMPTS=2

# --- Adaptive maker/taker execution ---
# maker is the safe default. adaptive may take only when every configured gate clears.
MONEY_NOODLE_ENTRY_EXECUTION_MODE=maker
MONEY_NOODLE_MIN_TAKER_NET_EDGE=0.15
MONEY_NOODLE_MIN_TAKER_MEDIAN_EDGE=0.10
MONEY_NOODLE_MIN_TAKER_QUALITY=0.65
MONEY_NOODLE_MAX_TAKER_SPREAD=0.02
MONEY_NOODLE_MIN_TAKER_MAKER_SAMPLES=30
MONEY_NOODLE_MIN_TAKER_ADVANTAGE=0.02

# --- Shared entry and exit policy controls ---
# 1 disables the claimed-edge ceiling. Changing this changes the admitted policy and requires versioning.
MONEY_NOODLE_MAX_NET_EDGE=1
MONEY_NOODLE_ALLOW_DOWN_ENTRY=true
# Comma-separated. Current evidence may justify local exclusions; an empty value admits every asset.
MONEY_NOODLE_EXCLUDED_ASSETS=
# Profit reversal is withheld by default; strict-value exits are independent.
MONEY_NOODLE_PROFIT_REVERSAL_EXIT=false

# --- Risk, reconciliation, and portfolio constraints ---
MONEY_NOODLE_MAX_CURRENT_EPOCH_DRAWDOWN_PERCENT=25
MONEY_NOODLE_MAX_LIFETIME_LIVE_LOSS_CENTS=50
MONEY_NOODLE_RECONCILIATION_INTERVAL_SECONDS=300
# Current code defaults: 9 total, 6 in one settlement window, 3 in one correlation group.
MONEY_NOODLE_MAX_OPEN_POSITIONS=9
MONEY_NOODLE_MAX_SAME_WINDOW_POSITIONS=6
MONEY_NOODLE_MAX_SAME_GROUP_POSITIONS=3
MONEY_NOODLE_CORRELATION_PENALTY_CENTS=1
MONEY_NOODLE_SAME_GROUP_PENALTY_CENTS=1

# --- Reduce-only switching ---
MONEY_NOODLE_MIN_SWITCH_GAIN_CENTS=1
MONEY_NOODLE_SWITCH_UNCERTAINTY_MARGIN_CENTS=1
MONEY_NOODLE_MIN_SWITCH_PROBABILITY_ADVANTAGE=0.15
MONEY_NOODLE_MIN_OPPOSITE_SIDE_ADVANTAGE=0.20
MONEY_NOODLE_SWITCH_COOLDOWN_SECONDS=180

# --- Adaptive current-policy regime gate ---
MONEY_NOODLE_REGIME_GATE_ENABLED=false
MONEY_NOODLE_REGIME_PAUSE_CONFIDENCE=0.99
MONEY_NOODLE_REGIME_RESUME_CONFIDENCE=0.75
MONEY_NOODLE_REGIME_MIN_POLICY_WINDOWS=12
MONEY_NOODLE_REGIME_EVIDENCE_HALF_LIFE_WINDOWS=12

# --- Long-shot round-trip policy ---
# Enabling the policy arms paper only. Live requires both flags and all account-wide protections.
MONEY_NOODLE_LONG_SHOT_ENABLED=false
MONEY_NOODLE_LONG_SHOT_LIVE_ENABLED=false
MONEY_NOODLE_LONG_SHOT_ENTRY_MARK_CENTS=10
MONEY_NOODLE_LONG_SHOT_EXIT_MARK_CENTS=90
MONEY_NOODLE_LONG_SHOT_MIN_SECONDS_REMAINING=600
MONEY_NOODLE_LONG_SHOT_DRAWDOWN_DIVISOR=30
MONEY_NOODLE_LONG_SHOT_MIN_TICKET_CENTS=10
MONEY_NOODLE_LONG_SHOT_MAX_OPEN_PER_WINDOW=3
MONEY_NOODLE_LONG_SHOT_MAX_ENTRIES_PER_ASSET_WINDOW=3
MONEY_NOODLE_LONG_SHOT_DAILY_LOSS_TICKETS=10
MONEY_NOODLE_LONG_SHOT_EXCLUDED_ASSETS=

# --- Persistent-worker-only S3-compatible archive ---
# Vercel is always excluded. Endpoint, prefix and cadence can be omitted to use code defaults.
MONEY_NOODLE_ARCHIVE_ENABLED=false
MONEY_NOODLE_ARCHIVE_BUCKET=
MONEY_NOODLE_ARCHIVE_ACCESS_KEY_ID=
MONEY_NOODLE_ARCHIVE_SECRET_ACCESS_KEY=
# MONEY_NOODLE_ARCHIVE_REGION=fr-par
# MONEY_NOODLE_ARCHIVE_ENDPOINT=https://s3.fr-par.scw.cloud
# MONEY_NOODLE_ARCHIVE_PREFIX=money-noodle/v1
# MONEY_NOODLE_ARCHIVE_INTERVAL_HOURS=24
# MONEY_NOODLE_ARCHIVE_STARTUP_DELAY_MINUTES=5
