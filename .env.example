# Continuous local ingestion runs every 15 seconds while the Next.js server is running.
# Set false to rely on browser polling only.
MONEY_NOODLE_BACKGROUND_INGESTION=true
# Canonical local/public URL used for Open Graph branding metadata.
MONEY_NOODLE_BASE_URL=http://localhost:3000
# Set true only for a stateless hosted research dashboard (Vercel is detected automatically).
# This disables collection, reconciliation, execution startup, and all durable writes.
MONEY_NOODLE_STATELESS=false
# Optional managed Postgres projection (for example Neon through Vercel Marketplace).
# The persistent worker is the only writer; the hosted dashboard should use a separate SELECT-only URL.
MONEY_NOODLE_DATABASE_URL=
# Keep false until db/migrations/001_public_paper_projection.sql is applied and the projection is verified.
MONEY_NOODLE_POSTGRES_PAPER_SYNC=false
# Dashboard authentication. Replace both placeholders with separate, strong values.
AUTH_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Hard safety cap for percentage-based trade sizing.
MONEY_NOODLE_MAX_PURCHASE_PERCENT=10
# Paper fills are capped independently from dynamic budget sizing until depth/replay validation is complete.
MONEY_NOODLE_MAX_PAPER_STAKE_CENTS=200

# Add only the providers you use, then save this file as .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Local OpenAI-compatible server (Ollama, LM Studio, etc.)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Optional account connectors
# Public Polymarket wallet enables read-only position monitoring.
POLYMARKET_WALLET_ADDRESS=
# Authenticated CLOB connector. Keep this key outside source control and use a dedicated limited-funds wallet.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# 0=EOA/browser wallet, 1=Polymarket proxy/email, 2=Gnosis Safe
POLYMARKET_SIGNATURE_TYPE=0
# Optional existing CLOB API credentials; otherwise they are derived from the signer.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYGON_RPC_URL=

# Kalshi signed account connector
KALSHI_API_KEY_ID=
# Prefer an absolute local path outside this repository and chmod 600 the PEM.
KALSHI_PRIVATE_KEY_PATH=
# Inline PEM is supported only when a secret manager injects it; do not commit it.
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n..."
# Validate against demo first: https://demo-api.kalshi.co/trade-api/v2
# Production: https://api.elections.kalshi.com/trade-api/v2
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# Trading credentials are intentionally not used in the read-only phase.

# Live execution. Off by default; the UI cannot turn this on.
MONEY_NOODLE_ENABLE_LIVE=false
# Emergency stop that overrides everything, including an armed live mode.
MONEY_NOODLE_KILL_SWITCH=false
# Hard ceiling per live order while the execution path is being verified.
MONEY_NOODLE_MAX_LIVE_STAKE_CENTS=25
# Rolling limit counts unique entry/exit orders with an actual fill; unfilled and rejected attempts do not count.
MONEY_NOODLE_MAX_LIVE_ORDERS_PER_HOUR=4
# Keep second maker attempts observation-only while retry adverse-selection evidence is negative. Hard maximum is 2.
MONEY_NOODLE_MAX_LIVE_MAKER_ATTEMPTS=1
# Paper defaults to the hard two-attempt cap so an early simulated maker miss can still shadow a later live buy.
MONEY_NOODLE_MAX_PAPER_MAKER_ATTEMPTS=2
# Entry execution is maker-live/shadow-taker by default. adaptive may submit guarded marketable IOC limits;
# taker is also guarded and never means an uncapped market order.
MONEY_NOODLE_ENTRY_EXECUTION_MODE=maker
MONEY_NOODLE_MIN_TAKER_NET_EDGE=0.15
MONEY_NOODLE_MIN_TAKER_MEDIAN_EDGE=0.10
MONEY_NOODLE_MIN_TAKER_QUALITY=0.65
MONEY_NOODLE_MAX_TAKER_SPREAD=0.02
MONEY_NOODLE_MIN_TAKER_MAKER_SAMPLES=30
MONEY_NOODLE_MIN_TAKER_ADVANTAGE=0.02
# Entry withholdings, each restrictive only: they can refuse a trade, never authorize one.
# A claimed edge at or above this fraction is treated as model failure rather than opportunity. 1 disables.
MONEY_NOODLE_MAX_NET_EDGE=0.35
# DOWN/NO entry is permitted; the v14 suspension was withdrawn when its evidence failed to reproduce.
# One switch for live and paper alike — the mirror runs the same policy, so there is no per-track flag.
MONEY_NOODLE_ALLOW_DOWN_ENTRY=true
# Assets withheld from entry on their own clustered per-window evidence, on both tracks.
# Comma-separated; set to empty to admit every asset. Measuring a withheld asset belongs in evaluation.
MONEY_NOODLE_EXCLUDED_ASSETS=XRP
# Whether an armed profit reversal may sell. Withheld by default: it scored negative against the hold it
# rejected on both tracks, and live clears two standard errors. Strict value exits are unaffected and stay
# on. Arming and high-water tracking continue regardless, so the counterfactual arms keep scoring it.
MONEY_NOODLE_PROFIT_REVERSAL_EXIT=false
# Non-auto-resumable economic stops. Current-period drawdown is proportional to configured allocation;
# lifetime loss is calculated from the immutable live execution ledger and survives budget reconfiguration.
MONEY_NOODLE_MAX_CURRENT_EPOCH_DRAWDOWN_PERCENT=25
MONEY_NOODLE_MAX_LIFETIME_LIVE_LOSS_CENTS=50
# Adaptive soft entry gate. One exact-contract sentinel per settlement window runs independently of
# paper bankroll and automatically reopens; it never stops exits, reconciliation, or operator intent.
MONEY_NOODLE_REGIME_GATE_ENABLED=false
MONEY_NOODLE_REGIME_PAUSE_CONFIDENCE=0.99
MONEY_NOODLE_REGIME_RESUME_CONFIDENCE=0.75
MONEY_NOODLE_REGIME_MIN_POLICY_WINDOWS=12
MONEY_NOODLE_REGIME_EVIDENCE_HALF_LIFE_WINDOWS=12
# Full signed Kalshi cash/position/order/fill/resting-order reconciliation cadence. Clamped to 60–3600s.
MONEY_NOODLE_RECONCILIATION_INTERVAL_SECONDS=300
# Constrained crypto portfolio defaults. Live and paper each use this total-position limit; hard maximum is 10.
MONEY_NOODLE_MAX_OPEN_POSITIONS=3
# At most two positions in one settlement window and one per correlation group.
MONEY_NOODLE_MAX_SAME_WINDOW_POSITIONS=2
MONEY_NOODLE_MAX_SAME_GROUP_POSITIONS=1
# Expected-dollar penalties applied for each same-window and same-group exposure, in cents.
MONEY_NOODLE_CORRELATION_PENALTY_CENTS=1
MONEY_NOODLE_SAME_GROUP_PENALTY_CENTS=1
# A switch must clear liquidation costs plus both margins and persist for 3 snapshots over 30 seconds.
MONEY_NOODLE_MIN_SWITCH_GAIN_CENTS=1
MONEY_NOODLE_SWITCH_UNCERTAINTY_MARGIN_CENTS=1
# Replacement-side probability must exceed the currently owned side by at least 15pp.
MONEY_NOODLE_MIN_SWITCH_PROBABILITY_ADVANTAGE=0.15
# Same-asset UP↔DOWN reversals use the stricter 20pp requirement in addition to positive net wealth.
MONEY_NOODLE_MIN_OPPOSITE_SIDE_ADVANTAGE=0.20
MONEY_NOODLE_SWITCH_COOLDOWN_SECONDS=180
