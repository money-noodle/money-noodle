{
  "version": 1,
  "routes": [
    {
      "id": "agent-harness",
      "label": "agent guidance and documentation governance",
      "pathPatterns": [
        "^(AGENTS\\.md|CLAUDE\\.md|SPEC\\.md|STATUS\\.md|spec/|docs/|status/|reports/README\\.md|scripts/verify-|scripts/agent-context|scripts/agent-context-manifest\\.json|\\.github/workflows/)"
      ],
      "taskKeywords": ["agent", "documentation", "specification", "status", "roadmap", "design index", "traceability", "verifier"],
      "fundedImpact": "none unless the task also changes a runtime route",
      "durableStateImpact": "none",
      "specModules": [],
      "designs": [],
      "sources": ["scripts/verify-agents-guide.mjs", "scripts/verify-spec-structure.mjs", "scripts/verify-design-docs.mjs", "scripts/verify-status-structure.mjs"],
      "tests": [],
      "records": ["Route requirement changes to the owning spec module and decision log; route projection or sequence changes to STATUS.md or status/roadmap.md."],
      "validation": ["npm run verify"],
      "prohibitions": ["Do not let generated routing output become requirement, runtime, or funded authority."]
    },
    {
      "id": "analysis",
      "label": "offline analysis and reports",
      "pathPatterns": ["^scripts/analyze-", "^reports/"],
      "taskKeywords": ["analyze", "analysis", "report", "measurement", "cohort", "evidence"],
      "fundedImpact": "none; analysis must remain read-only",
      "durableStateImpact": "read-only access to durable evidence",
      "specModules": ["spec/forecasting-and-evidence.md", "spec/policy-and-track-separation.md"],
      "designs": ["docs/offline-walk-forward-evaluation-design.md"],
      "sources": [],
      "tests": [],
      "records": ["Write dated findings under reports/ and update reports/README.md; update policy only through a separate manual decision."],
      "validation": ["npm run verify:agents"],
      "prohibitions": ["Do not write data/, place orders, promote a candidate, or reinterpret a surviving cohort as the full population."]
    },
    {
      "id": "product-ui",
      "label": "product surfaces and route presentation",
      "pathPatterns": ["^src/(app|components)/", "^spec/product-and-surfaces\\.md$"],
      "taskKeywords": ["dashboard", "dialog", "component", "interface", "filter", "display", "route presentation", "accessibility"],
      "fundedImpact": "possible when a signed mutation or control surface is involved",
      "durableStateImpact": "normally none for presentation-only changes",
      "specModules": ["spec/product-and-surfaces.md", "spec/storage-and-architecture.md"],
      "designs": ["docs/reporting-read-path-design.md", "docs/provider-policy-attribution-visibility-design.md"],
      "sources": ["src/lib/dashboard.ts"],
      "tests": ["src/lib/execution-signal-display.test.ts", "src/lib/signal-display-lifecycle.test.ts"],
      "records": ["Update STATUS.md when the implemented surface changes; update the owning design and index when lifecycle changes."],
      "validation": ["npm run typecheck", "npm test", "npm run build"],
      "prohibitions": ["Presentation filters and observation-only reads cannot gain ranking, eligibility, execution, budget, or reconciliation authority."]
    },
    {
      "id": "research",
      "label": "LLM research surface",
      "pathPatterns": ["^src/lib/llm\\.ts$", "^src/app/api/(research|providers)/", "^src/components/research-"],
      "taskKeywords": ["llm", "research chat", "provider model", "prompt", "openai", "anthropic"],
      "fundedImpact": "none by invariant",
      "durableStateImpact": "browser-local or provider-configuration state only",
      "specModules": ["spec/product-and-surfaces.md", "spec/delivery-and-acceptance.md"],
      "designs": [],
      "sources": ["src/lib/llm.ts", "src/app/api/research/route.ts"],
      "tests": [],
      "records": ["Update STATUS.md for implemented research-surface changes."],
      "validation": ["npm run typecheck", "npm test", "npm run build"],
      "prohibitions": ["LLM output must remain terminal and cannot reach forecast, policy, budget, reconciliation, or order paths."]
    },
    {
      "id": "forecast-policy",
      "label": "forecast, qualification, and policy evidence",
      "pathPatterns": ["^spec/(forecasting-and-evidence|policy-and-track-separation)\\.md$", "^src/lib/(basis-model|prediction-policy|policy-manifest|forecast|signal-persistence|regime-gate|entry-execution-policy)"],
      "taskKeywords": ["forecast", "probability", "entry policy", "buy policy", "qualification", "candidate", "promotion", "calibration", "signal persistence"],
      "fundedImpact": "direct when production forecast or entry policy changes",
      "durableStateImpact": "forecast history, policy history, or candidate evidence",
      "specModules": ["spec/forecasting-and-evidence.md", "spec/policy-and-track-separation.md", "spec/trading-risk-and-budget.md"],
      "designs": ["docs/forecast-model-and-evaluator-v3-design.md", "docs/live-opportunity-decision-flow.md"],
      "sources": ["src/lib/prediction-policy.ts", "src/lib/policy-manifest.ts", "src/lib/entry-execution-policy.ts"],
      "tests": ["src/lib/prediction-policy.test.ts", "src/lib/policy-manifest.test.ts", "src/lib/mirror-invariant.test.ts"],
      "records": ["A production policy change requires a new manifest version/history, evidence, canonical requirement change, and accepted decision."],
      "validation": ["npm run verify", "npm run typecheck", "npm test"],
      "prohibitions": ["No candidate, evaluator, report, or LLM may promote automatically or alter either trading lane."],
      "traceability": ["req-forecast-production-model", "req-forecast-issuance", "req-policy-mirror-invariant"]
    },
    {
      "id": "providers-markets",
      "label": "provider, market, and contract capability",
      "pathPatterns": ["^spec/providers-and-market-data\\.md$", "^src/lib/(trading-provider-registry|market-registry|kalshi|polymarket|feeds|venue-)"],
      "taskKeywords": ["provider", "venue", "market registry", "contract", "kalshi", "polymarket", "adapter", "capability"],
      "fundedImpact": "possible; any live capability is funded-path work",
      "durableStateImpact": "provider, market, contract, and order provenance",
      "specModules": ["spec/providers-and-market-data.md", "spec/trading-risk-and-budget.md", "spec/policy-and-track-separation.md"],
      "designs": ["docs/venue-traffic-and-rate-limits.md", "docs/live-opportunity-decision-flow.md"],
      "sources": ["src/lib/trading-provider-registry.ts", "src/lib/market-registry.ts", "src/lib/asset-registry.ts", "src/lib/hourly-threshold-market.ts", "src/lib/hourly-threshold-market-service.ts"],
      "tests": ["src/lib/trading-provider-registry.test.ts", "src/lib/market-registry.test.ts", "src/lib/asset-registry.test.ts", "src/lib/hourly-threshold-market.test.ts", "src/lib/hourly-threshold-market-service.test.ts", "src/lib/hourly-threshold-isolation.test.ts", "src/lib/venue-target-integrity.test.ts"],
      "records": ["A new provider or market requires registry changes, canonical requirements, an accepted design/decision, capability tests, and STATUS.md."],
      "validation": ["npm run verify", "npm run typecheck", "npm test"],
      "prohibitions": ["New provider × market capabilities fail closed; configuration and visible quotes cannot promote implementation."],
      "traceability": ["req-provider-registry-variants", "req-provider-contract-normalization", "req-trading-market-keying"]
    },
    {
      "id": "funded-execution",
      "label": "paper/live execution, budget, exits, and reconciliation",
      "pathPatterns": ["^spec/trading-risk-and-budget\\.md$", "^src/lib/(live-order|live-risk|budget|provider-budget|paper-execution|paper-maker|paper-fill|entry-sizing|managed-maker|venue-fill|venue-fee|execution-reconciliation|periodic-reconciliation|reconciliation|portfolio|switch|exit-policy|trading-control|execution-drain|automation-resume)"],
      "taskKeywords": ["order", "live execution", "paper execution", "budget", "money", "fill", "fee", "reconciliation", "exit", "switch", "pause", "resume", "maker", "taker"],
      "fundedImpact": "direct or adjacent; treat as funded-path work",
      "durableStateImpact": "budget, execution ledger, order/fill/position lifecycle, or reconciliation state",
      "specModules": ["spec/trading-risk-and-budget.md", "spec/policy-and-track-separation.md", "spec/providers-and-market-data.md", "spec/storage-and-architecture.md"],
      "designs": ["docs/live-opportunity-decision-flow.md", "docs/paper-execution-fidelity-v2-design.md", "docs/paper-fill-calibration-design.md", "docs/incremental-background-reconciliation-design.md", "docs/execution-ledger-v9-design.md"],
      "sources": ["src/lib/live-orders.ts", "src/lib/paper-execution.ts", "src/lib/paper-maker-simulation.ts", "src/lib/paper-fill-calibration.ts", "src/lib/execution-reconciliation.ts", "src/lib/periodic-reconciliation.ts"],
      "tests": ["src/lib/budget-ledger.test.ts", "src/lib/paper-maker-fill.test.ts", "src/lib/mirror-invariant.test.ts", "src/lib/strategy-isolation.test.ts", "src/lib/venue-target-integrity.test.ts", "src/lib/execution-reconciliation.test.ts"],
      "records": ["Agree structural prose before code; update the owning design/index, canonical module, decision log, and STATUS.md in the same change."],
      "validation": ["npm run verify", "npm run typecheck", "npm test", "npm run build"],
      "prohibitions": ["Do not inspect or mutate funded runtime state for code verification; do not relax fail-closed, reconciliation, arming, cap, or reduce-only boundaries."],
      "traceability": ["req-trading-budget-model", "req-trading-pause-resume", "req-trading-paper-engine", "req-trading-entry-route", "req-trading-intent-identity", "req-trading-cancellation", "req-trading-reconciliation", "req-trading-portfolio-switch", "req-trading-reduce-only-sells"]
    },
    {
      "id": "storage-runtime",
      "label": "durable storage and runtime ownership",
      "pathPatterns": ["^spec/storage-and-architecture\\.md$", "^src/lib/(cache|forecast-storage|execution-ledger|runtime-environment|task-cadence|hourly-threshold-observer|hourly-threshold-observation|.*-store)"],
      "taskKeywords": ["storage", "journal", "ledger", "cache", "shard", "compaction", "runtime owner", "stateless", "cadence"],
      "fundedImpact": "possible when storage carries budget, execution, or reconciliation authority",
      "durableStateImpact": "direct",
      "specModules": ["spec/storage-and-architecture.md", "spec/trading-risk-and-budget.md"],
      "designs": ["docs/forecast-storage-design.md", "docs/forecast-storage-generation-repair-design.md", "docs/execution-ledger-v9-design.md", "docs/second-market-hourly-crypto-design.md"],
      "sources": ["src/lib/cache.ts", "src/lib/forecast-storage.ts", "src/lib/execution-ledger-storage.ts", "src/lib/hourly-threshold-observation-store.ts", "src/lib/hourly-threshold-observer.ts", "src/lib/runtime-environment.ts"],
      "tests": ["src/lib/forecast-storage.test.ts", "src/lib/execution-ledger-store.test.ts", "src/lib/forecast-writer-authority.test.ts", "src/lib/hourly-threshold-observation.test.ts", "src/lib/hourly-threshold-h2-isolation.test.ts"],
      "records": ["Structural storage changes require agreed design, canonical requirements, decision history, and STATUS.md."],
      "validation": ["npm run verify", "npm run typecheck", "npm test"],
      "prohibitions": ["Never hand-edit ledgers, rewrite append-only journals, or make a stateless host an owner or writer."],
      "traceability": ["req-storage-local", "req-storage-architecture"]
    }
  ]
}
